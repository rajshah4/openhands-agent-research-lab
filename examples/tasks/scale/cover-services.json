    "sets": {
      "auth-only": ["auth"], "billing-only": ["billing"], "chat-only": ["chat"],
      "data-only": ["data"], "events-only": ["events"], "files-only": ["files"],
      "logs-only": ["logs"], "search-only": ["search"], "users-only": ["users"],
      "identity": ["auth", "users", "billing"],
      "content": ["chat", "files", "search"],
      "operations": ["data", "events", "logs"]
    }
  }
}
